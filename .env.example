# ══ MODO DEMO ═══════════════════════════════════════════════
# Sin ninguna llave, la app corre local con datos de demostración.

# ══ DATOS REALES DE INSTAGRAM (Zernio) ══════════════════════
# 1. Conecta @scav_86 en https://zernio.com (Instagram Login for
#    Business — no requiere Facebook ni app de Meta).
# 2. Crea una API key en su dashboard y pégala aquí.
ZERNIO_API_KEY=

# ══ IA (generador de guiones y reportes con Claude) ═════════
ANTHROPIC_API_KEY=

# ══ PRODUCCIÓN (Supabase: BD + Storage + Auth) ══════════════
# Al configurar estas variables, la app deja de usar ./data y pasa
# a Supabase, y el login con allowlist se activa automáticamente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Único correo autorizado si algún día reactivas el login (hoy desactivado)
OWNER_EMAIL=

# Secreto del cron diario (7:00 a.m.) — cualquier cadena larga aleatoria.
# El scheduler llama: GET /api/cron/sync con "authorization: Bearer <secreto>"
CRON_SECRET=
