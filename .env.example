# ══ MODO DEMO ═══════════════════════════════════════════════
# Sin ninguna llave, la app corre local con datos de demostración.

# ══ DATOS REALES DE INSTAGRAM (Zernio) ══════════════════════
# 1. Conecta tu cuenta en https://zernio.com (Instagram Login for
#    Business — no requiere Facebook ni app de Meta).
# 2. Crea una API key en su dashboard y pégala aquí.
# Esta es la key de la PRIMERA cuenta. Las cuentas que añadas desde
# la app (Conexión → Añadir cuenta) guardan la suya cifrada en la BD.
ZERNIO_API_KEY=

# ══ MULTICUENTA — cifrado de las API keys ═══════════════════
# Obligatoria para añadir cuentas desde la app. 64 caracteres hex:
#   openssl rand -hex 32
# ⚠️ Si la cambias, las keys ya guardadas dejan de descifrarse y hay
# que volver a pegarlas en cada cuenta.
ENCRYPTION_KEY=

# ══ IA — Agente OS (OpenRouter, motor único) ═════════════════
# Crea una key en https://openrouter.ai/keys.
# ⚠️ Este archivo se sube a git: pega tu key real en .env.local, no aquí.
OPENROUTER_API_KEY=
# Modelo a usar (formato "proveedor/modelo" de OpenRouter). Cambiar esto no
# requiere tocar código.
# `openrouter/free` es el ENRUTADOR de modelos gratuitos: OpenRouter elige por ti
# el gratuito con más disponibilidad en cada momento, en vez de fijar uno que
# puede estar caído o saturado. Para fijar uno concreto, pon aquí su nombre
# (p. ej. anthropic/claude-sonnet-5).
OPENROUTER_MODEL=openrouter/free

# ══ COMPETENCIA Y LINKS DE VIDEO (Apify) ═════════════════════
# Token de https://console.apify.com/account/integrations.
# Hace falta para DOS cosas:
#   · analizar el link de un reel pegado en el chat del Agente OS
#   · refrescar competencia si pones COMPETITOR_PROVIDER=apify
# Sin él, ambas fallan diciendo que falta — nunca devuelven ceros.
# Se factura por lectura: ~0.003 USD cada una (medido). Con el cron diario y 10
# competidores son ~300 lecturas al mes ≈ 1 USD, dentro de los 5 USD del plan
# gratuito. Los links que analices en el chat suman aparte.
APIFY_TOKEN=
# Actor a usar. Cambiarlo no requiere tocar código.
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper

# De dónde salen los datos de los competidores:
#   instagram-public → lee el perfil público directo. Gratis, pero Instagram
#                      lo bloquea casi siempre desde una IP de servidor.
#   apify            → vía Apify. De pago, pero funciona.
# Cuando falle, los datos se registran a mano desde la app y el agente los
# marca igual como estimados.
COMPETITOR_PROVIDER=instagram-public

# ══ PRODUCCIÓN — base de datos (Postgres) ═══════════════════
# Al definirla, la app deja de usar ./data y guarda todo en Postgres
# (tabla app_store, se crea sola). En Railway: añade el servicio Postgres
# y referencia su URL con ${{Postgres.DATABASE_URL}}.
DATABASE_URL=

# ══ LOGIN (Auth.js) ═════════════════════════════════════════
# Hay dos métodos y conviven: usuario/contraseña y Google.
#
# Firma las cookies de sesión: openssl rand -base64 32
# Definirla activa el login por CORREO Y CONTRASEÑA (registro abierto).
# Si no hay ni esta ni las de Google, la app corre sin login, en modo demo.
AUTH_SECRET=

# Opcional: añade el botón "Continuar con Google". Si faltan, el login sigue
# funcionando solo con contraseña. Crea el OAuth Client en Google Cloud
# Console — ver DEPLOY.md.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL pública de la app (necesaria detrás del proxy de Railway)
AUTH_URL=

# Secreto del cron diario (7:00 a.m.) — cualquier cadena larga aleatoria.
# El scheduler llama: GET /api/cron/sync con "authorization: Bearer <secreto>"
CRON_SECRET=
