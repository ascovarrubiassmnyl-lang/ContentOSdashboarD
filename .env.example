# ══ MODO DEMO ═══════════════════════════════════════════════
# Sin ninguna llave, la app corre local con datos de demostración.

# ══ DATOS REALES DE INSTAGRAM (Zernio) ══════════════════════
# 1. Conecta tu cuenta en https://zernio.com (Instagram Login for
#    Business — no requiere Facebook ni app de Meta).
# 2. Crea una API key en su dashboard y pégala aquí.
# Esta es la key de la PRIMERA cuenta. Las cuentas que añadas desde
# la app (Conexión → Añadir cuenta) guardan la suya cifrada en la BD.
ZERNIO_API_KEY=

# ══ MULTICUENTA — cifrado de las API keys ═══════════════════
# Obligatoria para añadir cuentas desde la app. 64 caracteres hex:
#   openssl rand -hex 32
# ⚠️ Si la cambias, las keys ya guardadas dejan de descifrarse y hay
# que volver a pegarlas en cada cuenta.
ENCRYPTION_KEY=

# ══ IA (generador de guiones y reportes con Claude) ═════════
ANTHROPIC_API_KEY=

# ══ PRODUCCIÓN (Supabase: BD + Storage + Auth) ══════════════
# Al configurar estas variables, la app deja de usar ./data y pasa a
# Supabase, y el login con Google se activa automáticamente (abierto a
# cualquier cuenta — ver DEPLOY.md → "Login con Google" para activar el
# provider en el Dashboard de Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ══ LOGIN CON GOOGLE ═════════════════════════════════════════
# Configurá el provider de Google en Supabase Dashboard → Authentication →
# Providers (ver DEPLOY.md). No hace falta ninguna variable extra acá — las
# credenciales de Google viven en Supabase, no en esta app.

# Correo que reclama, la primera vez que entra, las cuentas de Instagram
# creadas ANTES de este cambio (que todavía no tienen dueño). Se usa una
# sola vez y después se puede borrar de las variables de entorno.
LEGACY_OWNER_EMAIL=

# Secreto del cron diario (7:00 a.m.) — cualquier cadena larga aleatoria.
# El scheduler llama: GET /api/cron/sync con "authorization: Bearer <secreto>"
CRON_SECRET=
